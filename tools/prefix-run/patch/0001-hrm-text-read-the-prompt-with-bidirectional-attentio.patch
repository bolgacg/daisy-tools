From d71e9569d876d061fe5478ad2f6f5b14e05430c8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bolga=C3=A7=20G=C3=BClen?= <bolgacg1@gmail.com>
Date: Sat, 5 Sep 2026 22:26:10 +0200
Subject: [PATCH] hrm-text: read the prompt with bidirectional attention when
 prefix_lm is set

DFM-Mimir is trained as a prefix LM: prompt tokens attend to each other in both
directions and only generated tokens are causal. The GGUF already carries the
prefix_lm flag; this makes decode honour it. A multi-token ubatch is prompt
processing and runs with causal attention off; a single-token ubatch is
generation and runs causally, the same split vLLM's hrm_text.py uses.

The prompt must fit one ubatch (n_ubatch >= prompt length) for the
bidirectional pass to cover it; a warning is logged otherwise.
---
 src/llama-context.cpp   | 14 ++++++++++++++
 src/models/hrm-text.cpp |  2 +-
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 1c898da..812c252 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1720,6 +1720,11 @@ int llama_context::decode(const llama_batch & batch_inp) {
 
     GGML_ASSERT((cparams.causal_attn || cparams.n_ubatch >= n_tokens_all) && "non-causal attention requires n_ubatch >= n_tokens");
 
+    if (model.hparams.hrm_prefix_lm && n_tokens_all > 1 && n_tokens_all > cparams.n_ubatch) {
+        LLAMA_LOG_WARN("%s: prefix-LM prompt of %d tokens exceeds n_ubatch = %d; prompt tokens in different chunks will not see each other (use n_ubatch >= prompt length)\n",
+                __func__, n_tokens_all, cparams.n_ubatch);
+    }
+
     // TODO: this clear of the buffer can easily be forgotten - need something better
     // sync first so any in-flight async copies into embd_seq complete before it is freed
     if (!embd_seq.empty()) {
@@ -1821,8 +1826,17 @@ int llama_context::decode(const llama_batch & batch_inp) {
 
         ggml_status status;
 
+        // prefix-LM models (hrm-text): the prompt is attended in both directions, generated tokens causally.
+        // a multi-token ubatch is prompt processing, a single-token ubatch is generation
+        const bool causal_attn_org = cparams.causal_attn;
+        if (model.hparams.hrm_prefix_lm) {
+            cparams.causal_attn = ubatch.n_tokens == 1;
+        }
+
         const auto * res = process_ubatch(ubatch, ctx_type_to_graph_type(cparams.ctx_type), mctx.get(), status);
 
+        cparams.causal_attn = causal_attn_org;
+
         if (!res) {
             // the last ubatch failed or was aborted -> remove all positions of that ubatch from the memory module
             llama_pos pos_min[LLAMA_MAX_SEQ];
diff --git a/src/models/hrm-text.cpp b/src/models/hrm-text.cpp
index 52b522b..b2cd9be 100644
--- a/src/models/hrm-text.cpp
+++ b/src/models/hrm-text.cpp
@@ -11,7 +11,7 @@ void llama_model_hrm_text::load_arch_hparams(llama_model_loader & ml) {
     ml.get_key(LLM_KV_H_CYCLES, hparams.n_hrm_h_cycles);
     ml.get_key(LLM_KV_L_CYCLES, hparams.n_hrm_l_cycles);
 
-    // prefix-LM prefill is not implemented (causal attention only); kept for round-trip
+    // prefix-LM: the prompt is attended bidirectionally in llama_context::decode when this is set
     ml.get_key(LLM_KV_PREFIX_LM, hparams.hrm_prefix_lm, false);
 
     GGML_ASSERT(hparams.n_hrm_layers_per_stack > 0);
